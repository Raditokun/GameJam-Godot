[sub_resource type="Shader" id="Shader_l6ote"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;

uniform float opacity = 1.0;
uniform float emission = 1.0;

uniform vec2 distortion_power = vec2(0.0);

uniform sampler2D main_tex : source_color, filter_linear, repeat_enable;
uniform vec2 main_tiling = vec2(1.0);
uniform vec2 main_offset = vec2(0.0);

uniform sampler2D gradient : source_color, repeat_disable;
uniform sampler2D emission_curve : filter_linear, repeat_disable;

varying flat uint instance_id;
varying float age;

void vertex()
{
	instance_id = uint(INSTANCE_ID);
	age = INSTANCE_CUSTOM.y;
}

void fragment()
{
	float distortion_s = sin(UV.y * 10.0) * pow(COLOR.x, 2.0);
	vec2 distortion = distortion_power * distortion_s;
	vec4 main_s = texture(main_tex, UV * main_tiling + main_offset + distortion);
	ALPHA = pow(1.0 - COLOR.z, 1.0);
	ALPHA *= main_s.r;
	ALPHA = clamp(ALPHA * opacity, 0.0, 1.0);
	ALBEDO = texture(gradient, vec2(ALPHA)).rgb;
	ALBEDO *= texture(emission_curve, vec2(ALPHA)).r;
}"

