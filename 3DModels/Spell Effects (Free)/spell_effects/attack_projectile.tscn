[sub_resource type="GDScript" id="GDScript_x5ttj"]
script/source = "@tool
extends CharacterBody3D

signal hit(target: Node, hit_position: Vector3)

var dir: Vector3
var collided := false
var trail_scale := 1.0

var list := [
	[ \"Inner Color\", [
		{ \"node_path\": \"HeadInner\", \"object_path\": \"process_material\", \"property\": \"shader_parameter/initial_color\" },
	]],
	[ \"Outer Color\", [
		{ \"node_path\": \"HeadOuter\", \"object_path\": \"process_material\", \"property\": \"shader_parameter/initial_color\" },
	]],
	[ \"Glow Color\", [
		{ \"node_path\": \"ScatteredGlow\", \"object_path\": \"process_material\", \"property\": \"shader_parameter/u_m4_rgb\" },
	]],
	[ \"Trail Color\", [
		{ \"node_path\": \"Trail\", \"object_path\": \"material_override\", \"property\": \"shader_parameter/gradient\" },
	]],
]

func _ready() -> void:
	if Engine.is_editor_hint():
		return
	for n in get_children():
		if n is GPUParticles3D:
			if n.has_meta(\"delay\"):
				get_tree().create_timer(n.get_meta(\"delay\")).timeout.connect(start.bind(n))
			else:
				start(n)
		if n is Node3D:
			n.position = Vector3()

func _process(delta: float) -> void:
	if collided and trail_scale > 0.0:
		trail_scale = max(0.01, trail_scale - delta * 5.0)
		$Trail.scale.y = trail_scale

func start(node: GPUParticles3D) -> void:
	node.restart()

func _physics_process(delta: float) -> void:
	if Engine.is_editor_hint() or collided:
		return
	var collision := move_and_collide(dir * delta * 20.0)
	if collision and collision.get_collision_count() > 0:
		collided = true
		hit.emit(collision.get_collider(0), collision.get_position(0))
		for n in get_children():
			if n is GPUParticles3D:
				n.emitting = false
				n.visible = false
		global_position = collision.get_position(0)

func aim(direction: Vector3) -> void:
	dir = direction.normalized()
	var right := Vector3(0, 1, 0).cross(dir).normalized()
	var front := dir.cross(right).normalized()
	basis = Basis(
		right * scale.x,
		dir * scale.y,
		front * scale.y
	)

func _get_property_list() -> Array[Dictionary]:
	if !is_inside_tree() or !Engine.is_editor_hint():
		return []
	var l: Array[Dictionary]
	for group in list:
		for prop in group[1]:
			var node: Node = self
			if prop.has(\"node_path\"):
				node = get_node(prop.node_path)
				if !node:
					print(\"Node not found %s\" % prop.node_path)
					continue
			var obj: Object = node
			if prop.has(\"object_path\"):
				obj = node.get(prop.object_path)
				if !obj:
					print(\"Object not found %s\" % prop.object_path)
					continue
				if prop.has(\"sub_object_path\"):
					obj = obj.get(prop.sub_object_path)
					if !obj:
						print(\"Sub-object not found %s\" % prop.sub_object_path)
						continue
			if obj == self:
				continue
			var prop_list = obj.get_property_list()
			var done := false
			for p in prop_list:
				if p.name == prop.property:
					var property = p.duplicate()
					property.name = group[0]
					l.push_back(property)
					done = true
					break
			if done:
				break
	return l

func _get(property: StringName) -> Variant:
	if !is_inside_tree() or !Engine.is_editor_hint():
		return null
	var r := find_property(property)
	if !r.is_empty():
		return r.object.get(r.property)
	else:
		return null

func _set(property: StringName, value: Variant) -> bool:
	if !is_inside_tree() or !Engine.is_editor_hint():
		return false
	for group in list:
		if group[0] != property:
			continue
		for prop in group[1]:
			var node: Node = self
			if prop.has(\"node_path\"):
				node = get_node(prop.node_path)
				if !node:
					continue
			var obj: Object = node
			if prop.has(\"object_path\"):
				obj = node.get(prop.object_path)
				if !obj:
					continue
				if prop.has(\"sub_object_path\"):
					obj = obj.get(prop.sub_object_path)
					if !obj:
						continue
			obj.set(prop.property, value)
	return false

func find_property(property: StringName) -> Dictionary:
	for group in list:
		if property != group[0]:
			continue
		for prop in group[1]:
			var node: Node = self
			if prop.has(\"node_path\"):
				node = get_node(prop.node_path)
				if !node:
					continue
			var obj: Object = node
			if prop.has(\"object_path\"):
				obj = node.get(prop.object_path)
				if !obj:
					continue
				if prop.has(\"sub_object_path\"):
					obj = obj.get(prop.sub_object_path)
					if !obj:
						continue
			return { \"node\": node, \"object\": obj, \"property\": prop.property }
	return {}
"

