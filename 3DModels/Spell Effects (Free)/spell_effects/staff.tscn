[sub_resource type="GDScript" id="GDScript_sf37b"]
script/source = "@tool
extends Node3D

@export var effect_container: NodePath

var alive := 0

var list := [
	[ \"Main Color\", [
		{ \"node_path\": \"Emitters/Aura\", \"object_path\": \"material_override\", \"property\": \"shader_parameter/gradient\" },
	]],
	[ \"Ember Color\", [
		{ \"node_path\": \"Emitters/Embers\", \"object_path\": \"draw_pass_1\", \"sub_object_path\": \"material\", \"property\": \"shader_parameter/gradient\" },
	]],
	[ \"Glow Color\", [
		{ \"node_path\": \"Emitters/Glow\", \"object_path\": \"process_material\", \"property\": \"shader_parameter/initial_color\" },
	]],
	[ \"Trail Color\", [
		{ \"node_path\": \"Trail\", \"object_path\": \"material_override\", \"property\": \"shader_parameter/gradient\" },
	]],
]

func _ready() -> void:
	if Engine.is_editor_hint():
		return
	var container: Node = self
	if effect_container:
		container = get_node(effect_container)
	for n in container.get_children():
		if n is GPUParticles3D:
			if n.has_meta(\"delay\"):
				get_tree().create_timer(n.get_meta(\"delay\")).timeout.connect(start.bind(n))
			else:
				start(n)
			alive += 1

func start(node: GPUParticles3D) -> void:
	node.restart()
	node.finished.connect(on_finished)

func on_finished() -> void:
	alive -= 1
	if alive <= 0:
		queue_free()

func stop(node: Node = null) -> void:
	if !node:
		node = self
	if node is GPUParticles3D:
		node.emitting = false
	for c in node.get_children():
		stop(c)

func _get_property_list() -> Array[Dictionary]:
	if !is_inside_tree() or !Engine.is_editor_hint():
		return []
	var l: Array[Dictionary]
	for group in list:
		for prop in group[1]:
			var node: Node = self
			if prop.has(\"node_path\"):
				node = get_node(prop.node_path)
				if !node:
					print(\"Node not found %s\" % prop.node_path)
					continue
			var obj: Object = node
			if prop.has(\"object_path\"):
				obj = node.get(prop.object_path)
				if !obj:
					print(\"Object not found %s\" % prop.object_path)
					continue
				if prop.has(\"sub_object_path\"):
					obj = obj.get(prop.sub_object_path)
					if !obj:
						print(\"Sub-object not found %s\" % prop.sub_object_path)
						continue
			if obj == self:
				continue
			var prop_list = obj.get_property_list()
			var done := false
			for p in prop_list:
				if p.name == prop.property:
					var property = p.duplicate()
					property.name = group[0]
					l.push_back(property)
					done = true
					break
			if done:
				break
	return l

func _get(property: StringName) -> Variant:
	if !is_inside_tree() or !Engine.is_editor_hint():
		return null
	var r := find_property(property)
	if !r.is_empty():
		return r.object.get(r.property)
	else:
		return null

func _set(property: StringName, value: Variant) -> bool:
	if !is_inside_tree() or !Engine.is_editor_hint():
		return false
	for group in list:
		if group[0] != property:
			continue
		for prop in group[1]:
			var node: Node = self
			if prop.has(\"node_path\"):
				node = get_node(prop.node_path)
				if !node:
					continue
			var obj: Object = node
			if prop.has(\"object_path\"):
				obj = node.get(prop.object_path)
				if !obj:
					continue
				if prop.has(\"sub_object_path\"):
					obj = obj.get(prop.sub_object_path)
					if !obj:
						continue
			obj.set(prop.property, value)
	return false

func find_property(property: StringName) -> Dictionary:
	for group in list:
		if property != group[0]:
			continue
		for prop in group[1]:
			var node: Node = self
			if prop.has(\"node_path\"):
				node = get_node(prop.node_path)
				if !node:
					continue
			var obj: Object = node
			if prop.has(\"object_path\"):
				obj = node.get(prop.object_path)
				if !obj:
					continue
				if prop.has(\"sub_object_path\"):
					obj = obj.get(prop.sub_object_path)
					if !obj:
						continue
			return { \"node\": node, \"object\": obj, \"property\": prop.property }
	return {}
"

