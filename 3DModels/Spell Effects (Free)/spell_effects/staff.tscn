[sub_resource type="Shader" id="Shader_n1mjv"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled;

uniform sampler2D main_tex : source_color, filter_linear_mipmap, repeat_disable;

uniform sampler2D noise_tex : source_color, filter_linear_mipmap, repeat_enable;
uniform vec2 noise_tiling = vec2(1.0);
uniform vec2 noise_offset = vec2(0.0);
uniform vec2 noise_speed = vec2(0.0);

uniform sampler2D gradient : source_color, repeat_disable;
uniform sampler2D emission_curve : repeat_disable, filter_linear;

uniform float pivot = 0.0;

uniform sampler2D depth_tex : hint_depth_texture, filter_nearest, repeat_disable;
uniform float proximity_fade_distance = 0.5;

uniform float alpha_threshold : hint_range(0.0, 1.0, 0.01) = 0.01;
uniform float alpha_feather : hint_range(0.0, 1.0, 0.01) = 0.025;


float rand(inout uint seed) {
	int k;
	int s = int(seed);
	if (s == 0) {
		s = 305420679;
	}
	k = s / 127773;
	s = 16807 * (s - k * 127773) - 2836 * k;
	if (s < 0) {
		s += 2147483647;
	}
	seed = uint(s);
	return float(seed % uint(65536)) / 65535.0;
}

float rand_range(inout uint seed, float l, float h) {
	return l + (h - l) * rand(seed);
}

float proximity_fade(vec3 vertex, vec2 screen_uv, mat4 inv_proj_matrix) {
	float depth = textureLod(depth_tex, screen_uv, 0.0).r;
	vec4 world_pos = inv_proj_matrix * vec4(screen_uv * 2.0 - 1.0, depth, 1.0);
	world_pos.xyz /= world_pos.w;
	return clamp(1.0 - smoothstep(world_pos.z + proximity_fade_distance, world_pos.z, vertex.z), 0.0, 1.0);
}

varying flat uint instance_id;
varying float age;

void vertex()
{
	instance_id = uint(INSTANCE_ID);
	age = INSTANCE_CUSTOM.y;
	vec4 offset = vec4(normalize(CAMERA_POSITION_WORLD - MODEL_MATRIX[3].xyz) * pivot, 0.0);
	mat4 model = mat4(
		normalize(MAIN_CAM_INV_VIEW_MATRIX[0]),
		normalize(MAIN_CAM_INV_VIEW_MATRIX[1]),
		normalize(MAIN_CAM_INV_VIEW_MATRIX[2]),
		MODEL_MATRIX[3] + offset);
	model = model * mat4(
		vec4(cos(INSTANCE_CUSTOM.x), -sin(INSTANCE_CUSTOM.x), 0.0, 0.0),
		vec4(sin(INSTANCE_CUSTOM.x), cos(INSTANCE_CUSTOM.x), 0.0, 0.0),
		vec4(0.0, 0.0, 1.0, 0.0),
		vec4(0.0, 0.0, 0.0, 1.0));
	model = model * mat4(
		vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0),
		vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0),
		vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0),
		vec4(0.0, 0.0, 0.0, 1.0));
	MODELVIEW_MATRIX = VIEW_MATRIX * model;
	MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
}

void fragment()
{
	uint seed = instance_id;
	vec4 main_s = texture(main_tex, UV);
	vec4 noise_s = texture(noise_tex, UV * noise_tiling + noise_offset + vec2(rand_range(seed, 0.0, 1.0), rand_range(seed, 0.0, 1.0)) + noise_speed * TIME);
	ALPHA = COLOR.a;
	ALPHA *= main_s.r;
	ALPHA *= noise_s.r;
	ALPHA = clamp(ALPHA, 0.0, 1.0);
	ALPHA *= proximity_fade(VERTEX, SCREEN_UV, INV_PROJECTION_MATRIX);
	ALPHA = smoothstep(alpha_threshold, alpha_threshold + alpha_feather, ALPHA);
	ALBEDO = COLOR.rgb;
	ALBEDO *= texture(gradient, vec2(ALPHA)).rgb;
	ALBEDO *= texture(emission_curve, vec2(ALPHA)).r;
}


"

