[sub_resource type="Shader" id="Shader_ssp6q"]
code = "shader_type spatial;
render_mode unshaded, cull_disabled, blend_add;

uniform float opacity = 1.0;
uniform float emission = 1.0;

uniform sampler2D mask_tex : source_color, filter_linear_mipmap, repeat_disable;

uniform sampler2D noise_tex : source_color, filter_linear_mipmap, repeat_enable;
uniform vec2 noise_tiling = vec2(1.0);
uniform vec2 noise_offset = vec2(0.0);
uniform vec2 noise_speed = vec2(0.0);

uniform sampler2D gradient_tex : source_color, filter_linear_mipmap, repeat_enable;
uniform vec2 gradient_tiling = vec2(1.0);
uniform vec2 gradient_offset = vec2(0.0);
uniform vec2 gradient_speed = vec2(0.0);

uniform sampler2D gradient : source_color, repeat_disable;

uniform float dissolve_feather = 0.025;
uniform sampler2D dissolve_curve : filter_linear, repeat_disable;

float rand(inout uint seed) {
	int k;
	int s = int(seed);
	if (s == 0) {
		s = 305420679;
	}
	k = s / 127773;
	s = 16807 * (s - k * 127773) - 2836 * k;
	if (s < 0) {
		s += 2147483647;
	}
	seed = uint(s);
	return float(seed % uint(65536)) / 65535.0;
}

float rand_range(inout uint seed, float l, float h) {
	return l + (h - l) * rand(seed);
}

float remap(float value, float input_min, float input_max, float output_min, float output_max) {
	return (clamp(value, input_min, input_max) - input_min) / (input_max - input_min) * (output_max - output_min) + output_min;
}

varying flat uint instance_id;
varying float age;

void vertex()
{
	instance_id = uint(INSTANCE_ID);
	age = INSTANCE_CUSTOM.y;
	vec4 offset = vec4(0.0);
	mat4 model = mat4(
		normalize(MAIN_CAM_INV_VIEW_MATRIX[0]),
		normalize(MAIN_CAM_INV_VIEW_MATRIX[1]),
		normalize(MAIN_CAM_INV_VIEW_MATRIX[2]),
		MODEL_MATRIX[3] + offset);
	model = model * mat4(
		vec4(cos(INSTANCE_CUSTOM.x), -sin(INSTANCE_CUSTOM.x), 0.0, 0.0),
		vec4(sin(INSTANCE_CUSTOM.x), cos(INSTANCE_CUSTOM.x), 0.0, 0.0),
		vec4(0.0, 0.0, 1.0, 0.0),
		vec4(0.0, 0.0, 0.0, 1.0));
	model = model * mat4(
		vec4(length(MODEL_MATRIX[0].xyz), 0.0, 0.0, 0.0),
		vec4(0.0, length(MODEL_MATRIX[1].xyz), 0.0, 0.0),
		vec4(0.0, 0.0, length(MODEL_MATRIX[2].xyz), 0.0),
		vec4(0.0, 0.0, 0.0, 1.0));
	MODELVIEW_MATRIX = VIEW_MATRIX * model;
	MODELVIEW_NORMAL_MATRIX = mat3(MODELVIEW_MATRIX);
}

void fragment()
{
	uint seed = instance_id;
	vec4 mask_s = texture(mask_tex, UV);
	vec4 noise_s = texture(noise_tex, UV * noise_tiling + noise_offset + vec2(rand_range(seed, 0.0, 1.0), rand_range(seed, 0.0, 1.0)) + noise_speed * TIME);
	vec4 gradient_s = texture(gradient_tex, UV * gradient_tiling + gradient_offset + vec2(rand_range(seed, 0.0, 1.0), rand_range(seed, 0.0, 1.0)) + gradient_speed * TIME);
	float dissolve_t = texture(dissolve_curve, vec2(age)).r;
	dissolve_t = remap(dissolve_t, 0.0, 1.0, -dissolve_feather, 1.0);
	ALPHA = COLOR.a;
	ALPHA *= mask_s.r;
	ALPHA *= noise_s.r;
	ALPHA = clamp(ALPHA * opacity, 0.0, 1.0);
	ALPHA *= smoothstep(dissolve_t, dissolve_t + dissolve_feather, ALPHA);
	ALBEDO = COLOR.rgb * emission;
	ALBEDO *= texture(gradient, vec2(gradient_s.r)).rgb;
	
}


"

